# Porta em que a aplicacao vai rodar (o Render define isso automaticamente em producao)
PORT=3000

# Dados de conexao com o banco MySQL (ex: instancia Aiven)
DB_HOST=seu-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=sua_senha_aqui
DB_NAME=eventhub
# Aiven exige SSL. Defina como "true" para exigir certificado seguro.
DB_SSL=true

# Segredo usado para assinar o cookie de sessao (gere uma string aleatoria longa)
SESSION_SECRET=troque_por_uma_string_aleatoria_bem_grande

# "production" habilita cookies com flag secure (exige HTTPS, como no Render)
NODE_ENV=development
