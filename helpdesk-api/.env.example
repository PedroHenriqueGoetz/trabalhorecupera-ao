PORT=4000

# Banco de dados MySQL (ex: instancia Aiven)
DB_HOST=seu-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=sua_senha_aqui
DB_NAME=helpdesk
DB_SSL=true

# Segredo para assinar os tokens JWT (gere uma string aleatoria longa)
JWT_SECRET=troque_por_uma_string_aleatoria_bem_grande
JWT_EXPIRES_IN=8h

# URL publica do front-end autorizado a consumir esta API (CORS)
FRONTEND_URL=http://localhost:5500

NODE_ENV=development
